# Copy to `.env` and fill in real keys — `.env` is gitignored, never commit it.
# Load before running the MCP server:
#   set -a && source .env && set +a
#   python -m dabwayo.mcp_server

# Jamendo (primary: full royalty-free / CC tracks) — register an app at
# https://devportal.jamendo.com  (only the client id is needed for search/fetch)
JAMENDO_CLIENT_ID=your_jamendo_client_id

# Freesound (optional: ambience / SFX layers) — apply at
# https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=your_freesound_api_key

# Where fetch_music saves downloads (default: assets/audio)
# DABWAYO_MUSIC_DIR=assets/audio
